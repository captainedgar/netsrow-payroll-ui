generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogSnapshot {
  key     String @id
  payload Json
}

model Company {
  id       String    @id @default(uuid())
  name     String
  accounts Account[]
  products Product[]
}

model Account {
  id           String    @id @default(uuid())
  email        String    @unique
  password    String
  canManageCatalog Boolean @default(false)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  sessions    Session[]
}

model Session {
  digest    String   @id
  accountId String
  expiresAt DateTime
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Product {
  id        String  @id @default(uuid())
  name      String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model CommercialQuoteRequest {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  locale         String
  catalogVersion String
  selection      Json
  contact        Json

  @@index([createdAt])
}
