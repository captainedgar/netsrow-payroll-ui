# PostgreSQL local publicado por compose.yaml.
DATABASE_URL=postgresql://netsrow:netsrow_dev@127.0.0.1:55432/netsrow

# Puerto de NestJS y destino del proxy de Vite.
API_PORT=3002
WEB_PORT=3011

# Habilitar conjuntamente, únicamente para pruebas de recepción comercial.
NETSROW_COMMERCIAL_INTAKE=false
VITE_NETSROW_COMMERCIAL_INTAKE=false
